# .env.local 로 복사해서 채운다 (.env.local 은 git 에 안 올라간다)

# 로그인 계정 — 아이디:비밀번호:역할 (역할 master = 관리자·미리 보기 / child = 아이), 쉼표로 여러 개
# 아이 계정은 관리자 페이지에서 만들 수도 있다(MongoDB 연결 후)
ACCOUNTS=master:바꿀비밀번호:master
# 로그인 열쇠 서명용 비밀 문자열 — 아무 긴 글자. Vercel 에 올릴 때는 꼭 넣는다
AUTH_SECRET=

# MongoDB 접속 주소 — 비워 두면 진도는 기기에만 저장된다(아이 관리도 꺼짐)
MONGODB_URI=
# DB 이름 (기본 todohangul)
MONGO_DB=todohangul

# Typecast 음성 굽기 (scripts/typecast.mts) — API 요금제는 웹 요금제와 크레딧이 따로
TYPECAST_API_KEY=
# 성우 voice_id (tc_…) — 비우면 한국어 이름(민정·수아)으로 찾는다
TYPECAST_VOICE_MINJEONG=
TYPECAST_VOICE_SUA=

# 그림 호스팅(회사 Cafe24) — 앱은 /cdn 으로 불러온다. 배포에는 아래 두 줄만
CAFE24_PUBLIC_BASE_URL=
CAFE24_UPLOAD_DIR=
# npm run image:upload 전용
CAFE24_FTP_HOST=
CAFE24_FTP_PORT=21
CAFE24_FTP_USER=
CAFE24_FTP_PASS=
